#!/bin/sh
# Block every direct commit to main/dev. No exceptions — not for docs, not for
# session bookkeeping, not for a one-line fix. core/git-discipline.md states
# branch hygiene applies with no stated exception; a prior carve-out for
# "state-only" files here contradicted that doctrine and was itself the reason
# direct-to-main commits kept recurring (see
# docs/inbox/git-discipline-self-repo-direct-to-main-drift.md, resolved
# 2026-09-08 in favor of enforcement over a carve-out).
#
# Use: git checkout -b <type>/YYYYMMDD-<description>

BRANCH=$(git branch --show-current)

case "$BRANCH" in
  main|dev)
    echo ""
    echo "  BLOCKED: direct commit to '$BRANCH'"
    echo ""
    echo "  Every change — including docs, inbox filings, and session bookkeeping —"
    echo "  goes through a branch + PR. No exceptions."
    echo ""
    echo "  Create one now:"
    echo "    git stash"
    echo "    git checkout -b <type>/$(date +%Y%m%d)-<description>"
    echo "    git stash pop"
    echo ""
    exit 1
    ;;
esac

exit 0
